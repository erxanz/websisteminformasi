# Folder unggahan tidak boleh diakses langsung.
# Foto profil dilayani lewat rute aplikasi /media/profil/{file}.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Jangan pernah menjalankan berkas apa pun di dalam folder ini.
<FilesMatch "\.(php|php[0-9]|phtml|phar|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
